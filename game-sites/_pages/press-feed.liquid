---
pagination:
  data: gameSitesWithPress
  size: 1
  alias: game
permalink: "/{{ game.slug }}/press.xml"
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ game.title | escape }} — Press</title>
    <link>https://bychkovskyi.com{{ game.url }}/press</link>
    <atom:link href="https://bychkovskyi.com{{ game.url }}/press.xml" rel="self" type="application/rss+xml" />
    <description>Articles, interviews, and other materials featuring {{ game.title | escape }}</description>
    {% assign sorted = game.press | sort: "date" | reverse -%}
    {% assign newest = sorted | first -%}
    {% if newest %}<lastBuildDate>{{ newest.date | rfc822 }}</lastBuildDate>{% endif %}
    {% for article in sorted %}
    <item>
      <title>{{ article.title | escape }}</title>
      <link>{{ article.url }}</link>
      <guid isPermaLink="true">{{ article.url }}</guid>
      <dc:language xmlns:dc="http://purl.org/dc/elements/1.1/">{{ article.lang }}</dc:language>
      <pubDate>{{ article.date | rfc822 }}</pubDate>
    </item>
    {% endfor %}
  </channel>
</rss>
