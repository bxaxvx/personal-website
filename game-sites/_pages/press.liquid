---
layout: game
pagination:
  data: gameSitesWithPress
  size: 1
  alias: game
permalink: "/{{ game.slug }}/press/index.html"
eleventyComputed:
  title: "{{ game.title }} - Featured In"
  description: "Articles, interviews, and other materials featuring {{ game.title }}"
---
<style>
  /* Same list as the site-wide Featured In page (press.liquid). */
  #press {
    list-style: none;
    text-align: left;
    max-width: 45em;
    margin: auto;
    padding: 0 1em;

    > li {
      display: flex;
      align-items: baseline;
      gap: 0.75em;
      margin-bottom: 1.5em;

      @media (prefers-reduced-motion: no-preference) {
        animation: bounce-appear;
      }
    }

    .date {
      flex: none;
      width: 8em;
      color: rgb(from var(--fg) r g b / 55%);
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
    }

    /* SVG instead of emoji: Chromium on Windows/Linux has no flag emoji glyphs */
    .flag {
      flex: none;
      display: inline-block;
      width: 1.2em;
      height: 0.8em;
      margin: 0;
      border-radius: 2px;
      object-fit: cover;
      position: relative;
      top: 0.05em;
    }

    > li > a {
      min-width: 0;
      white-space: normal;
    }

    .youtube {
      flex: none;
      align-self: center;
      display: inline-flex;
      color: rgb(from var(--fg) r g b / 55%);
    }

    .youtube svg {
      width: 1.1em;
      height: 1.1em;
    }
  }

  #subscribe {
    margin: 0 0 2em;
  }
</style>

<p id="subscribe">
  <a class="dim" title="Subscribe via RSS" href="{{ game.url }}/press.xml">{% include 'rss.svg' %}</a>
</p>

<ul id="press">
  {% assign sorted = game.press | sort: "date" | reverse %}
  {% for article in sorted %}
    <li class="selectable" style="animation-duration: {{ forloop.index0 | times: 0.1 | plus: 0.7 }}s;">
      <span class="date">{{ article.date | date: "%b %-d, %Y" }}</span>
      {% if article.lang == "uk" %}
        <img class="flag" src="/images/flags/ua.svg" alt="Ukrainian" title="Ukrainian">
      {% else %}
        <img class="flag" src="/images/flags/gb.svg" alt="English" title="English">
      {% endif %}
      <a href="{{ article.url }}">{{ article.title }}</a>
      {% if article.url contains "youtube.com" %}
        <span class="youtube" role="img" aria-label="YouTube" title="YouTube">{% include 'icons/YouTube.svg' %}</span>
      {% endif %}
    </li>
  {% endfor %}
</ul>
